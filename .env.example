# Copy to backend/.env and adjust. Never commit the real .env file.
APP_ENV=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required when APP_ENV != development. In development a random ephemeral key is used if empty.
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
DATABASE_URL=sqlite:///./incidentiq.db
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
LOG_LEVEL=INFO
# Password for seeded SYNTHETIC demo users. If empty, the seed script generates one and prints it once.
DEMO_PASSWORD=
# Directory with trusted, locally trained joblib model artifacts (joblib can execute code on load; never point at untrusted files)
# MODEL_DIR=../ml/artifacts

# ---- Phase 3: routing policy (never auto-assigns; analyst approval is always required) ----
ROUTING_ENABLED=false
# Autopilot: poll ServiceNow for new unassigned tickets and triage them (never writes to ServiceNow).
AUTOPILOT_ENABLED=false
# Also assign locally when routing is enabled and calibrated confidence meets both thresholds.
AUTOPILOT_AUTO_ASSIGN=false
AUTOPILOT_INTERVAL_SECONDS=300
AUTOPILOT_MAX_PER_CYCLE=25
ROUTING_THRESHOLD_CATEGORY=0.90
ROUTING_THRESHOLD_TEAM=0.90

# ---- Phase 3: optional Gemini assistance (summary / field extraction only) ----
GEMINI_ENABLED=false
# Server-side secret. Leave empty to stay offline.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Alternative to an API key: Vertex AI with Application Default Credentials (gcloud auth application-default login).
# Newer Gemini models are served from the "global" location.
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GEMINI_TIMEOUT_SECONDS=20
GEMINI_MAX_RETRIES=2
GEMINI_MAX_INPUT_CHARS=2000

# ---- Phase 3: optional ServiceNow Personal Developer Instance ----
SERVICENOW_ENABLED=false
# read_only (default: GET only) | live (PATCH allowed after approval)
SERVICENOW_MODE=read_only
SERVICENOW_INSTANCE_URL=
# basic | oauth
SERVICENOW_AUTH=basic
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=
SERVICENOW_OAUTH_CLIENT_ID=
SERVICENOW_OAUTH_CLIENT_SECRET=
SERVICENOW_TIMEOUT_SECONDS=15
SERVICENOW_MAX_RETRIES=2
